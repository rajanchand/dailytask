# Copy to `.env` and fill in real values locally / on the server.
# NEVER commit `.env` — it is gitignored. This file is a public template only.

# --- App / auth ---
DATABASE_URL=
REDIS_URL=
AUTH_SECRET=
AUTH_URL=
NEXTAUTH_URL=
APP_URL=
APP_NAME=Daily Task Managing System
UPLOAD_DIR=./uploads
ALLOW_PUBLIC_REGISTER=false

# --- SMTP (invites + password reset) ---
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Discord (optional) ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_CHANNEL_NAME=
DISCORD_SERVER_NAME=
DISCORD_WEBHOOK_URL=

# --- System Health ops gate (separate from normal login) ---
# Required to unlock /system-health after super_admin sign-in.
# Prefer a bcrypt hash (generate with: node -e "require('bcryptjs').hash('YOUR_OPS_PASSWORD',12).then(console.log)")
# If using Docker Compose, escape each $ in the hash as $$ in this file (Compose interpolates $VARS).
SYSTEM_HEALTH_EMAIL=
SYSTEM_HEALTH_PASSWORD_HASH=
# Optional plaintext fallback (prefer HASH above; leave empty in shared templates):
SYSTEM_HEALTH_PASSWORD=
# Optional HMAC secret for the unlock cookie (defaults to AUTH_SECRET):
SYSTEM_HEALTH_SECRET=
