DATABASE_URL=postgresql://dailyflow:dailyflow@localhost:5434/dailyflow
REDIS_URL=redis://localhost:6381
AUTH_SECRET=replace-with-openssl-rand-base64-48
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_NAME=Dailytask Manager
UPLOAD_DIR=./uploads

# Invite-only by default (set true only for open signup)
ALLOW_PUBLIC_REGISTER=false

# SMTP — required for invites + password reset emails
# Product From address (must match a mailbox you can send as on IONOS):
MAIL_FROM=noreply@zero-trust-security.org
#
# IONOS Mail (typical):
#   SMTP_HOST=smtp.ionos.com          # or smtp.ionos.co.uk for UK accounts
#   SMTP_PORT=587
#   SMTP_SECURE=false                 # true only if using port 465
#   SMTP_USER=noreply@zero-trust-security.org   # full mailbox email
#   SMTP_PASS=your-mailbox-password             # IONOS mailbox password
#
# Create the mailbox in IONOS Email → Email Addresses if it does not exist yet,
# or use any existing mailbox on zero-trust-security.org and set MAIL_FROM/SMTP_USER accordingly
# (MAIL_FROM must remain noreply@zero-trust-security.org for this product).
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Discord bot (for keyword replies + Send Report fallback without webhook)
# Create at https://discord.com/developers/applications
# Enable "Message Content Intent" under Bot → Privileged Gateway Intents
DISCORD_BOT_TOKEN=
# Optional: channel for report posts when no webhook is saved in Discord settings
DISCORD_CHANNEL_ID=
DISCORD_CHANNEL_NAME=#dailyflow
DISCORD_SERVER_NAME=
# Optional direct webhook (overrides empty DB integration)
DISCORD_WEBHOOK_URL=
