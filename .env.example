# Copy to `.env` and fill in real values locally / on the server.
# NEVER commit `.env` — it is gitignored. This file is a public template only.

# --- App / auth ---
DATABASE_URL=
REDIS_URL=
AUTH_SECRET=
# Must match the public HTTPS origin (no trailing slash). Keep these three identical in prod.
AUTH_URL=
NEXTAUTH_URL=
APP_URL=
APP_NAME=Daily Task Managing System
UPLOAD_DIR=./uploads
ALLOW_PUBLIC_REGISTER=false

# --- Compose Postgres (docker-compose.prod.yml) ---
POSTGRES_USER=dailyflow
POSTGRES_PASSWORD=
POSTGRES_DB=dailyflow
APP_PORT=3000
# Soft resource caps for the app container (optional)
# APP_MEM_LIMIT=1536m
# APP_CPUS=2.0

# --- Boot / seed (production) ---
# MUST stay false in production unless you intentionally wipe users/tasks.
RUN_SEED=false
# Optional one-time seed overrides (only used when you run db:seed / RUN_SEED=true)
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=
# SEED_PASSWORD=
# SEED_TIMEZONE=Europe/London
# SEED_FORCE_PASSWORD_CHANGE=true
# ALLOW_INSECURE_SEED=false

# --- SMTP (invites + password reset) ---
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Discord (optional) ---
# Run at most ONE discord bot replica. Redis is required for cross-process reply dedupe.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_CHANNEL_NAME=
DISCORD_SERVER_NAME=
DISCORD_WEBHOOK_URL=

# --- System Health ops gate ---
# Preferred: first-time setup in the UI at /system-health (super_admin only).
# Credentials (email, password hash, PIN hash, lock state) live in
# `system_health_credentials` — never commit real secrets.
#
# Optional HMAC secret for the unlock cookie (defaults to AUTH_SECRET):
SYSTEM_HEALTH_SECRET=
#
# Optional legacy env bootstrap ONLY when the DB table has no row yet.
# After in-app setup, the database is the source of truth and these are ignored.
# SYSTEM_HEALTH_EMAIL=
# SYSTEM_HEALTH_PASSWORD_HASH=
# SYSTEM_HEALTH_PASSWORD=

# --- Login session GeoIP (optional) ---
# On login, country + ISP are looked up asynchronously and stored on user_sessions.
# Default provider: free ip-api.com over HTTP (no API key). Login never waits on geo.
# GEOIP_DISABLED=1
# GEOIP_LOOKUP_URL=http://ip-api.com/json/{ip}?fields=status,country,isp,query
