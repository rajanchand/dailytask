DATABASE_URL=postgresql://dailyflow:dailyflow@localhost:5434/dailyflow
REDIS_URL=redis://localhost:6381
AUTH_SECRET=replace-with-openssl-rand-base64-48
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_NAME=Dailytask Manager
UPLOAD_DIR=./uploads

# Invite-only by default (set true only for open signup)
ALLOW_PUBLIC_REGISTER=false

# SMTP (required for invites + password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@zero-trust-security.org

# Discord bot (for keyword replies in channel)
# Create at https://discord.com/developers/applications
# Enable "Message Content Intent" under Bot → Privileged Gateway Intents
DISCORD_BOT_TOKEN=
